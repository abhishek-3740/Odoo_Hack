          "name": "2.1 Who Am I (/api/v1/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "me"]
            },
            "description": "Returns verified profile identity, active role, team ID, customer ID, and calculated capability array."
          }
        }
      ]
    },
