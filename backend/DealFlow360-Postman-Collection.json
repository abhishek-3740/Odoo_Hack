{
  "info": {
    "_postman_id": "dealflow360-api-collection-v1",
    "name": "DealFlow360 API - Verification Collection",
    "description": "Comprehensive Postman verification collection for DealFlow360 backend APIs with pre-seeded demo accounts (Admin, Rep, Manager, Finance, Customer).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Authentication & Demo Accounts",
      "item": [
        {
          "name": "1.1 List All Demo Accounts & Tokens",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/demo-accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "demo-accounts"]
            },
            "description": "Returns all 8 demo personas (Admin, Rep A, Rep B, Manager A, Backup Manager, Finance, Customer Alpha, Customer Beta) with ready-to-use Bearer tokens and curl examples."
          }
        },
        {
          "name": "1.2 Login as Demo Admin (Auto-Sets {{token}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('token', res.data.accessToken);",
                  "    pm.environment.set('token', res.data.accessToken);",
                  "    console.log('Successfully authenticated as ' + res.data.email + ' (' + res.data.role + ')');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@dealflow.demo\",\n  \"password\": \"demo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates as Demo Admin. Post-response test script automatically sets the 'token' variable for all subsequent requests."
          }
        },
        {
          "name": "1.3 Login as Sales Rep A (Auto-Sets {{token}})",
          "event": [
