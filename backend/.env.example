# DealFlow360 API — environment template.
# Copy to .env (git-ignored) or export in your shell. Every value here is a
# placeholder; never commit live secrets.

# --- Database ---------------------------------------------------------------
# Matches the PostgreSQL 18 container in the README:
#   docker run -d --name dealflow-pg18 -e POSTGRES_PASSWORD=12345678
#     -e POSTGRES_USER=postgres -e POSTGRES_DB=demo -p 5432:5432
#     -v dealflow_pg18_data:/var/lib/postgresql postgres:18
# For a hosted project use the SESSION pooler URL, not the transaction pooler:
# this is a persistent backend that relies on prepared statements and row locks.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/demo
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=12345678
DB_POOL_MAX=5

# Flyway migrates through the primary DataSource. To migrate with a broader
# credential than the runtime role, override just the credentials:
# SPRING_FLYWAY_USER=
# SPRING_FLYWAY_PASSWORD=

# --- Identity (Supabase Auth) ---------------------------------------------
# Configure EXACTLY ONE of the two verification modes:
#   (a) shared HS256 secret — the local Docker stack's default;
#   (b) asymmetric JWKS     — hosted projects with signing keys enabled.
# Local default secret (Supabase CLI):
AUTH_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# AUTH_JWK_SET_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER_URI=http://127.0.0.1:54321/auth/v1
AUTH_EXPECTED_AUDIENCE=authenticated
# First sign-in of an unknown email creates a Sales Rep profile. Set false to
# require explicit provisioning through POST /api/v1/admin/profiles.
AUTH_AUTO_PROVISION_REP=true

# Comma-separated exact origins allowed for CORS and the WebSocket upgrade.
# The frontend dev server runs on 3000 (3001 when 3000 is busy); 5173/4173 are Vite's own defaults.
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Used only by scripts/create-demo-users.mjs, never by the API at runtime.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- Behaviour --------------------------------------------------------------
BILLING_TIMEZONE=Asia/Kolkata
ALLOCATION_MODE=BALANCED          # BALANCED | MIN_SHIPMENTS | MIN_COST
JOBS_ENABLED=true                 # billing sweep, health sweep, outbox dispatcher

# --- Demo controls ----------------------------------------------------------
# Seeds the synthetic dataset on startup (idempotent). Off in production.
DEMO_SEED=false
# Movable business date for showing a month elapsing on stage. Only honoured
# when DEMO_MODE=true; ignored otherwise so no request can backdate a charge.
DEMO_MODE=false
# DEMO_BUSINESS_DATE=2026-09-16

# Signs email/password tokens for customers who register through the storefront
# (POST /api/v1/auth/register). Falls back to DEMO_JWT_SECRET when unset.
# AUTH_LOCAL_JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret

# Optional hackathon/Postman identities. These tokens use their own signing
# secret and can therefore coexist with Supabase hosted-JWKS authentication.
# Keep false in any shared or production environment.
DEMO_AUTH_ENABLED=false
# DEMO_JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret

# Server-only Sarvam credentials. Never put this key in VITE_* variables.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

PORT=8080
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN
