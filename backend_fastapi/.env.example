# DealFlow360 FastAPI — local environment template.
# Copy to backend_fastapi/.env (git-ignored). Same names as backend/.env.

# --- Database (local PostgreSQL, no Docker) ---
SPRING_DATASOURCE_URL=postgresql+asyncpg://postgres:12345678@127.0.0.1:5432/demo
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=12345678
DB_POOL_MAX=5

# --- Identity (local HS256 default; exactly one of secret/JWKS for Supabase) ---
AUTH_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# AUTH_JWK_SET_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER_URI=http://127.0.0.1:54321/auth/v1
AUTH_EXPECTED_AUDIENCE=authenticated
AUTH_AUTO_PROVISION_REP=true
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- Behaviour ---
BILLING_TIMEZONE=Asia/Kolkata
ALLOCATION_MODE=BALANCED
JOBS_ENABLED=true

# --- Demo controls ---
DEMO_SEED=false
DEMO_MODE=false
# DEMO_BUSINESS_DATE=2026-09-16
DEMO_AUTH_ENABLED=false
# DEMO_JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
# AUTH_LOCAL_JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret

# --- Integrations ---
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

PORT=8080
