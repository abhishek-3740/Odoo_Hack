# DealFlow360 FastAPI — local environment template.
# Copy to backend_fastapi/.env (git-ignored). Same names as backend/.env.

# --- Database (local PostgreSQL, no Docker) ---
# Replace YOUR_PASSWORD with the password for your local postgres user.
# DATABASE_URL is also accepted and takes precedence when set.
SPRING_DATASOURCE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@127.0.0.1:5432/demo
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_PASSWORD
DB_POOL_MAX=5

# --- Integration tests ---
# Optional. Defaults to the connection settings above with database
# "dealflow_test" instead of "demo".
# DEALFLOW_TEST_DB_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@127.0.0.1:5432/dealflow_test

# --- Identity (local HS256 default; exactly one of secret/JWKS for Supabase) ---
AUTH_JWT_SECRET=replace-with-a-32-byte-or-longer-secret
# AUTH_JWK_SET_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER_URI=http://127.0.0.1:54321/auth/v1
AUTH_EXPECTED_AUDIENCE=authenticated
AUTH_AUTO_PROVISION_REP=true
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- Behaviour ---
BILLING_TIMEZONE=Asia/Kolkata
ALLOCATION_MODE=BALANCED
JOBS_ENABLED=true

# --- Demo controls ---
# Seed personas, customers, catalogue, stock, and policy on startup (idempotent).
DEMO_SEED=false
# Enable demo account discovery and one-click demo sign-in.
DEMO_AUTH_ENABLED=false
DEMO_MODE=false
# DEMO_BUSINESS_DATE=2026-09-16
# DEMO_JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
# AUTH_LOCAL_JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret

# --- Integrations (optional workspace assistant) ---
# First configured provider wins: Groq, then Gemini, then Sarvam.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

PORT=8080
