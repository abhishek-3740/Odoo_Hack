# DealFlow360 frontend — development configuration.
#
# Copy to `.env.local`. Nothing secret belongs in this file or in any VITE_*
# variable: everything here is compiled into the bundle and readable by anyone
# who opens the page. Supabase service keys and the assistant provider key live
# in the backend's own environment and are never read by this application.

# Where `npm run dev` proxies /api and /ws. Defaults to the local backend.
API_PROXY_TARGET=http://127.0.0.1:8080

# Production only. Leave both unset locally so the dev proxy and same-origin
# WebSocket are used. On Cloudflare Pages these are set as build-time variables:
#   VITE_API_BASE_URL=https://<render-service>.onrender.com/api/v1
#   VITE_WS_URL=wss://<render-service>.onrender.com/ws
# VITE_API_BASE_URL=
# VITE_WS_URL=

# The canonical origin used for the landing page's canonical URL and social
# metadata at build time.
SITE_ORIGIN=https://dealflow360.example

# Point the Playwright suite at an already-running frontend instead of letting
# it start one. Leave unset for local runs.
# E2E_BASE_URL=http://127.0.0.1:3001
